# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SecureCross V2.0 Configuration
SECURECROSS_ENV="development"
SECURECROSS_SECRET="securecross-auth-secret-key-change-in-production"
SECURECROSS_DAILY_LIMIT="50000"
SECURECROSS_TOKEN_TTL_SECONDS="180"

# PostgreSQL Configuration (Docker & Local Deployments)
POSTGRES_USER="securecross_user"
POSTGRES_PASSWORD="securecross_secure_password"
POSTGRES_DB="securecross_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://securecross_user:securecross_secure_password@localhost:5432/securecross_db"
